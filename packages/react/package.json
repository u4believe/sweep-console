{
  "name": "@sweepconsole/react",
  "version": "0.1.0",
  "description": "React component for the Sweep Console rail — an authorize button that opens the checkout over your own page",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "usdc",
    "stablecoin",
    "subscriptions",
    "payments",
    "react",
    "sweep-console"
  ],
  "peerDependencies": {
    "react": ">=17",
    "@sweepconsole/js": "^0.2.0"
  },
  "devDependencies": {
    "@sweepconsole/js": "workspace:*",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u4believe/sweep-console.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/u4believe/sweep-console#readme",
  "bugs": {
    "url": "https://github.com/u4believe/sweep-console/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
