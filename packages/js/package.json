{
  "name": "@sweepconsole/js",
  "version": "0.1.0",
  "description": "Pay-with-USDC button for the browser \u2014 asks your server for a checkout URL and sends the payer there",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button.css": "./dist/button.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-cdn.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/button.test.mjs",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "usdc",
    "stablecoin",
    "subscriptions",
    "payments",
    "checkout",
    "button",
    "sweep-console"
  ],
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u4believe/sweep-console.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/u4believe/sweep-console#readme",
  "bugs": {
    "url": "https://github.com/u4believe/sweep-console/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
